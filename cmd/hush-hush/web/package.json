{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "bun run copy-changelog && bun run copy-license && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"copy-changelog": "cp ../../../CHANGELOG.md static/CHANGELOG.md",
		"copy-license": "cp ../../../LICENSE static/LICENSE.txt",
		"dev": "bun run copy-changelog && bun run copy-license && vite dev",
		"format": "biome format --write .",
		"generate:api": "openapi-typescript ../../../api/openapi.yaml -o src/lib/api-schema.d.ts && bun scripts/generate-api-limits.ts",
		"generate:api:check": "openapi-typescript ../../../api/openapi.yaml -o src/lib/api-schema.d.ts --check && bun scripts/generate-api-limits.ts --check",
		"lighthouse": "bun run e2e/lighthouse.ts",
		"lint": "biome check .",
		"lint:tailwind": "oxlint -c .oxlintrc.json src",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"screenshots": "bun run e2e/screenshots.ts",
		"test": "bun run test:unit -- --run",
		"test:e2e": "playwright test",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@scure/bip39": "2.4.0",
		"@simplewebauthn/browser": "14.0.0",
		"age-encryption": "0.3.1",
		"bits-ui": "2.20.6",
		"clsx": "2.1.1",
		"svelte-toolbelt": "0.13.0",
		"tailwind-merge": "3.7.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.6",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.71.0",
		"@playwright/test": "1.65.0",
		"@shadcn/lint": "0.2.5",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "1.4.4",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "5.1.0",
		"jsdom": "31.0.0",
		"lighthouse": "13.6.0",
		"openapi-typescript": "7.13.0",
		"oxlint": "1.93.0",
		"playwright": "1.65.0",
		"playwright-lighthouse": "4.0.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-variants": "4.0.2",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"vite": "8.3.7",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "3.1.0"
	},
	"packageManager": "bun@1.3.14",
	"overrides": {
		"cookie": "2.0.1",
		"source-map-js": "1.2.2"
	}
}
