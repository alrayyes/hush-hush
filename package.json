{
  "name": "hush-hush-tooling",
  "private": true,
  "description": "Not a JavaScript project. This exists so commitlint can resolve the shared config it extends, which bunx alone cannot do, and so Prettier, markdownlint and Redocly are pinned like everything else.",
  "scripts": {
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:api": "redocly lint",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:package-json": "sort-package-json --check package.json",
    "lint:prose": "./scripts/lint-prose.sh",
    "lint:spectral": "spectral lint api/openapi.yaml",
    "prepare": "lefthook install",
    "test:ci": "bun scripts/test-ci.ts && bash scripts/test-build-reports.sh"
  },
  "overrides": {
    "katex": "0.19.0",
    "re2js": "2.9.1",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@redocly/cli": "2.71.2",
    "@stoplight/spectral-cli": "6.17.0",
    "@stoplight/spectral-owasp-ruleset": "2.0.1",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.10",
    "sort-package-json": "4.1.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
